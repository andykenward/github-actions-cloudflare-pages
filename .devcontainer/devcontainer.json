// For format and config option details, see https://aka.ms/devcontainer.json.
{
  "name": "Container - Cloudflare Pages Action",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    // Node 24 matches CI (.github/actions/setup-pnpm); pnpm matches packageManager.
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24",
      "pnpmVersion": "12.3.4"
    },
    // Extensions install at image build as the remote user. The option can't
    // pin a version, so each rebuild pulls the extension's latest release.
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {
      "extensions": "github/gh-stack"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "GraphQL.vscode-graphql",
        "GraphQL.vscode-graphql-syntax",
        "oxc.oxc-vscode",
        "TypeScriptTeam.native-preview",
        "vitest.explorer",
        "webpro.vscode-knip"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },
  "postCreateCommand": "pnpm install && prek install",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DISABLE_AUTOUPDATER": "1",
    "HISTFILE": "/home/vscode/.commandhistory/.zsh_history"
  },
  // Named volumes keyed by ${devcontainerId}, so Claude Code sign-in, gh CLI
  // auth and zsh history survive rebuilds without being shared with other
  // projects. gh extensions live in ~/.local/share/gh, outside the gh volume,
  // so they still come from the image build.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=zsh-history-${devcontainerId},target=/home/vscode/.commandhistory,type=volume"
  ],
  "remoteUser": "vscode"
}
