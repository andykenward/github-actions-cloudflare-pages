// For format and config option details, see https://aka.ms/devcontainer.json.
{
  "name": "Container - Cloudflare Pages Action",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "GraphQL.vscode-graphql",
        "GraphQL.vscode-graphql-syntax",
        "oxc.oxc-vscode",
        "TypeScriptTeam.native-preview",
        "vitest.explorer",
        "webpro.vscode-knip"
      ]
    }
  },
  // devcontainer-post-create (from the image) installs the mise tools and the
  // Claude Code CLI, so the rest runs after it. The ponytail plugin is enabled
  // in .claude/settings.json, but an external plugin is only fetched by an
  // explicit install; idempotent on rebuilds.
  "postCreateCommand": {
    "post-create": "devcontainer-post-create && mise exec -- pnpm i && mise exec -- prek install && claude plugin marketplace add ./.claude/marketplace && claude plugin install ponytail@cloudflare-pages-action --scope project"
  },
  "mounts": [
    "source=devcontainer-claude,target=/home/vscode/.claude,type=volume",
    "source=devcontainer-gh,target=/home/vscode/.config/gh,type=volume",
    "source=devcontainer-git,target=/home/vscode/.config/git,type=volume",
    "source=${devcontainerId}-mise,target=/home/vscode/.local/share/mise,type=volume",
    "source=${devcontainerId}-history,target=/commandhistory,type=volume",
    "source=${devcontainerId}-vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
  ],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
