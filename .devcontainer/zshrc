# Appended to ~/.zshrc by the Dockerfile, so it runs after Oh My Zsh and its theme.

# VS Code's injected zsh shell integration resets HISTFILE to ~/.zsh_history
# before sourcing ~/.zshrc, so containerEnv can't point zsh at the volume.
HISTFILE=/home/vscode/.commandhistory/.zsh_history

# Prompt: `user ➜ path/inside/repo (branch ✗)` with the command on its own
# line. The devcontainers theme shows /workspaces/<repo>, which pushes the
# command off the right edge.
ZSH_THEME_GIT_PROMPT_PREFIX="%{$fg_bold[cyan]%}(%{$fg_bold[red]%}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%{$fg_bold[cyan]%})%{$reset_color%}"
ZSH_THEME_GIT_PROMPT_DIRTY=" %{$fg_bold[yellow]%}✗"
ZSH_THEME_GIT_PROMPT_CLEAN=""
PROMPT='%{$fg[green]%}%n %(?:%{$reset_color%}➜ :%{$fg_bold[red]%}➜ )'
PROMPT+='%{$fg_bold[blue]%}$(git rev-parse --show-prefix 2>/dev/null || print -P %~)%{$reset_color%} '
PROMPT+='$(git_prompt_info)'
PROMPT+=$'\n''%{$fg[white]%}$ %{$reset_color%}'
