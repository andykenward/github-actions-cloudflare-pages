{
  "name": "github-actions-cloudflare-pages",
  "version": "3.5.0",
  "private": true,
  "description": "A Github Action to deploy to Cloudflare Pages",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "bugs": "https://github.com/andykenward/github-actions-cloudflare-pages/issues",
  "license": "MIT",
  "author": "Andy Kenward <andy@unlike.dev> (https://unlike.dev/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/andykenward/github-actions-cloudflare-pages.git"
  },
  "type": "module",
  "exports": "./dist/deploy/index.js",
  "scripts": {
    "act:d": "act -j delete --secret-file .env",
    "all": "node bin/sync-versions.ts && pnpm run knip && pnpm run codegen && pnpm run codegen:events && pnpm run codegen:cloudflare && pnpm run tsc:check && pnpm run format && pnpm run lint && pnpm run test && pnpm run build",
    "build": "rm -rf ./dist/* && node ./esbuild.config.js",
    "changeset": "changeset",
    "codegen": "graphql-codegen --config graphql.config.ts",
    "codegen:cloudflare": "node bin/codegen/cloudflare-pages.ts && pnpm run format",
    "codegen:events": "node bin/codegen/github-workflow-events.ts && pnpm run format",
    "codegen:watch": "pnpm run codegen --watch",
    "deployments:delete": "node bin/deployments/index.ts",
    "download": "node bin/download/index.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip --cache --cache-location '.cache/knip'",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "pnpm run lint --fix",
    "release": "pnpm run all && changeset publish",
    "skills:update": "skills update -p -y",
    "start": "node -r dotenv/config ./dist/index.js",
    "sync:readme": "tsx bin/sync-readme-versions.ts",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=github-actions",
    "test:watch": "vitest",
    "tsc:check": "tsc --noEmit --checkJs",
    "tsc:ls": "pnpm run tsc:check --listFilesOnly",
    "tsc:types": "pnpm run codegen && pnpm run codegen:events && pnpm run tsc:ls",
    "tsc:watch": "pnpm run tsc:check --watch",
    "version": "changeset version"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit-next/core": "3.0.0",
    "@octokit/plugin-paginate-rest": "15.0.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@octokit/openapi-webhooks": "12.1.0",
    "@octokit/openapi-webhooks-types": "12.1.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "graphql": "17.0.2",
    "graphql-tag": "2.12.7",
    "knip": "6.26.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "skills": "1.5.7",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "7.29.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": "^24.16.0",
    "pnpm": "^11.9.0"
  },
  "packageManager": "pnpm@12.3.4"
}
