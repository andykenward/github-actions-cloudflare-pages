{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "extraKnownMarketplaces": {
    "cloudflare-pages-action": {
      "source": {"source": "directory", "path": "./.claude/marketplace"}
    }
  },
  "enabledPlugins": {
    "typescript-7-lsp@cloudflare-pages-action": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ./.claude/scripts/stop-review-agents.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
